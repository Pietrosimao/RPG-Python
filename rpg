pocoes = 3

def mostrar_combate(jogador, inimigo):

    print("╔══════════════════════════════════════════════════╗")
    print("║                  ⚔ COMBATE ⚔                    ║")
    print("╠══════════════════════════════════════════════════╣")
    print("║                                                  ║")
    print("║  JOGADOR                         INIMIGO         ║")
    print("║                                                  ║")
    print("║  Nome:", jogador.nome, "                    Nome:", inimigo.nome)
    print("║  HP:", jogador.vida, "/", jogador.vida_maxima,
          "                  HP:", inimigo.vida)
    print("║                                                  ║")
    print("╠══════════════════════════════════════════════════╣")
    print("║                    AÇÕES                         ║")
    print("║                                                  ║")
    print("║  [0] 🏃 Fugir                                   ║")
    print("║  [1] ⚔ Atacar                                  ║")
    print("║  [2] 🧪 Usar poção                              ║")
    print("║                                                  ║")
    print("╚══════════════════════════════════════════════════╝")


while jogador.vida > 0 and inimigoescolhido.vida > 0:

    mostrar_combate(jogador, inimigoescolhido)

    combate = input("O que deseja? ")
    print()

    # 0 - FUGIR
    if combate == "0":
        print("Voce abandonou a batalha")
        break

    # 1 - ATACAR
    elif combate == "1":
        jogador.atacar(inimigoescolhido)

        if inimigoescolhido.vida > 0:
            inimigoescolhido.atacar(jogador)

    # 2 - USAR POÇÃO
    elif combate == "2":
        print("As poçoes recuperam 30 de", VERMELHO + "HP" + RESET)
        escolhausar = input("Deseja usar a poçao? ").lower()

        if escolhausar in["sim", "si", "simm"]:

            if pocoes > 0:
                pocoes -= 1

                if jogador.vida + 30 > jogador.vida_maxima:
                    jogador.vida = jogador.vida_maxima
                else:
                    jogador.vida += 30

                print("Voce recuperou", VERMELHO + "30 de hp" + RESET)
                print("Sobraram", pocoes, "poçoes")

            else:
                print("Suas poçoes acabaram")