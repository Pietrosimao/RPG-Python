class Personagens:
    def __init__(self, nome, vida, poder, dano, vida_maxima):
        self.nome = nome
        self.vida = vida
        self.poder = poder
        self.dano = dano
        self.vida_maxima = vida_maxima
    
    def atacar(self, inimigo):
        inimigo.vida -= self.dano

        print(self.nome, ROXO_CLARO + "atacou" + RESET, inimigo.nome)

        print()

        print(inimigo.nome , CIANO_CLARO + "agora tem" + RESET,inimigo.vida,"HP")

        print()

        if inimigo.vida<=0:
            print(AMARELO + "Sucesso, Inimigo Derrotado" + RESET)
        
