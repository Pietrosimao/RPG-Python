        personagens.vida -= self.dano

        if personagens.vida < 0:
            personagens.vida = 0

        print(self.nome, ROXO_CLARO + "atacou" + RESET ,personagens.nome )

        print()

        print(personagens.nome, CIANO_CLARO +"agora tem" + RESET, personagens.vida,"HP")

        print()
        
        if personagens.vida<=0:
            print(AMARELO + "Voce foi derrotado" + RESET)
    
