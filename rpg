class Personagens:
    def __init__(self, nome, vida, poder, dano, vida_maxima):
        self.nome = nome
        self.vida = vida
        self.poder = poder
        self.dano = dano
        self.vida_maxima = vida
    
    def atacar(self, inimigo):
        inimigo.vida -= self.dano
        print(self.nome,"atacou", inimigo.nome)
        print(inimigo.nome ,"agora tem",inimigo.vida,"HP")
        if inimigo.vida<=0:
            print(AMARELO + "Sucesso, Inimigo Derrotado" + RESET)
        
